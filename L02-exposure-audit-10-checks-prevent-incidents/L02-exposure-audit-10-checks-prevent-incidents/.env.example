# Copied to .env by `make bootstrap`. Placeholders only; never commit .env.
OPENCLAW_VERSION=2026.10.5
OPENCLAW_GATEWAY_PORT=18789
# Generated by bootstrap (32 random bytes). Leave empty here.
OPENCLAW_GATEWAY_TOKEN=
# Filled by bootstrap from your user id (1000 if you run as root).
OPENCLAW_UID=
OPENCLAW_GID=
