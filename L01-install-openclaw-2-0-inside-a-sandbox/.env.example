# Lesson 01 environment. Copy to .env (make setup does it), never commit .env.
# Placeholders only. Real values stay on your machine.

# Pinned image: OpenClaw 2026.10.4 (the "OpenClaw 2.0" release line).
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.10.4

# Host port for the Gateway. Published on 127.0.0.1 only.
OPENCLAW_GATEWAY_PORT=18789

# Generated by make setup (32 random bytes, hex). Leave empty here.
OPENCLAW_GATEWAY_TOKEN=

# Model provider: Google AI Studio (Gemini). Get a key at https://aistudio.google.com/apikey
# Use a project key with a spend limit. GOOGLE_API_KEY is also accepted as an alias.
OPENCLAW_AUTH_CHOICE=gemini-api-key
GEMINI_API_KEY=
# GOOGLE_API_KEY=
